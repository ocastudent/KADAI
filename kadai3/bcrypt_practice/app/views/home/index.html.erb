<h1>トップ画面</h1>

<% if user_signed_in? %>
  <p>Hello, <%= current_user.email %>!</p>
  <%= link_to 'My Page', user_path(current_user) %> |
  <%= link_to 'Logout', destroy_user_session_path, method: :delete %>
<% else %>
  <%= link_to 'サインアップ', new_user_registration_path %> |
  <%= link_to 'ログイン', new_user_session_path %>
<% end %>
